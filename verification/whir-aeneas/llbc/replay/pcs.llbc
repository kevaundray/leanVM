atum: its top bits are replaced by the stratum's.\n    /// - Indices are neither sorted nor deduplicated.\n    fn sample_queries(&mut self, depth: usize, count: usize) -> Vec<Self::Query>;\n\n    /// Each query's row of the oracle committed at `root`, a tree of `2^depth` leaves, authenticated by its path.\n    ///\n    /// - A leaf image is `leaf_words` words, its first `leaf_words - row_words` zero.\n    /// - A row is the image's last `row_words` words, in the order of `queries`.\n    ///\n    /// # Errors\n    ///\n    /// Returns an error on a missing or unauthenticated opening.\n    fn open_rows(\n        &mut self,\n        root: &Self::Root,\n        depth: usize,\n        queries: &[Self::Query],\n        row_words: usize,\n        leaf_words: usize,\n    ) -> Result<Vec<Vec<Self::K>>, TranscriptError>;\n\n    /// `a * k + d`, for `a` and `d` in `E` and a word `k` of `K`.\n    fn mul_k_add(&mut self, a: Self::E, k: Self::K, d: Self::E) -> Self::E;\n\n    /// The element of `E` with these limbs, lowest first.\n    fn e_of_limbs(&mut self, limbs: [Self::K; 3]) -> Self::E;\n\n    /// A query's index as a point: the element of `K`, embedded in `E`, whose bits are the index's.\n    fn query_point(&mut self, query: &Self::Query) -> Self::E;\n}","attr_info":{"attributes":[{"DocComment":" A verifier of the stacked opening: its commitments, its queries, and the rows they open."},{"DocComment":""},{"DocComment":" It extends the scalar verifier with the operations that touch roots, query indices and words of `K`."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Root","variance":"Invariant"},{"index":2,"name":"Self_K","variance":"Invariant"},{"index":3,"name":"Self_Query","variance":"Invariant"},{"ind