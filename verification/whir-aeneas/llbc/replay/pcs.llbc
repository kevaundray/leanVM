));\n        push_chunks(&mut out, [v.c0, v.c1, v.c2], d, take, block_len);\n    }\n    let strata = strata(count, d);\n    let mut i = 0;\n    while i < out.len().min(strata.len()) {\n        let s = strata[i];\n        let low = d - s.bits;\n        out[i] = (out[i] & ((1 << low) - 1)) | s.index << low;\n        i += 1;\n    }\n    out\n}","attr_info":{"attributes":[{"DocComment":" Sample `count` query positions of a domain of `block_len = 2^d`, in transcript order."},{"DocComment":""},{"DocComment":" - Each squeezed element of `E` yields `floor(192 / d)` positions: its disjoint `d`-bit chunks, low bits first."},{"DocComment":" - Each position then takes its stratum: its top bits are replaced by the stratum's."},{"DocComment":""},{"DocComment":" Positions are neither sorted nor deduplicated."},{"DocComment":""},{"DocComment":" A repeated position opens the same authenticated row again, which is harmless."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T0","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[48,{"data":{"file_id":5,"beg":{"line":123,"col":51},"end":{"line":123,"col":61}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":39}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":39},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":107},{"Deduplicated":0},{"Deduplicated":0}],"output":{"Deduplicated":44}},"src":"Normal","body":{"Structured":{"span":{"Value":[49,{"data":{"file_id":5,"beg":{"line":1