        .checked_add(config.log_inv_rates()[0])\n        .is_some_and(|depth| depth < bits)\n    {\n        return Err(WhirError::InvalidShape { level: 0 });\n    }\n    let mut level = 0;\n    let mut result = Ok(());\n    while level < config.level_ks().len() && result.is_ok() {\n        let k = config.level_ks()[level];\n        // An extension-field row holds three base words per interleaved value.\n        if k >= bits - 2 {\n            result = Err(WhirError::InvalidShape { level });\n        } else {\n            match remaining.checked_sub(k) {\n                None => result = Err(WhirError::InvalidShape { level }),\n                Some(next) => {\n                    remaining = next;\n                    if !remaining\n                        .checked_add(config.log_inv_rates()[level + 1])\n                        .is_some_and(|depth| depth > 0 && depth < bits)\n                    {\n                        result = Err(WhirError::InvalidShape { level });\n                    }\n                }\n            }\n        }\n        level += 1;\n    }\n    result\n}","attr_info":{"attributes":[{"DocComment":" Check all source-dependent dimensions before shifts, reads or challenges."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[128,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":9},"Shared"]}]},{"Deduplicated":0}],"output":{"Deduplicated":77}},"src":"Normal","body":{"Structured":{"span":{"Value":[195,{"data":{"file_id":6,"beg":{"line":210,"col":0},"end":{"line":247,"col":1}},"generated_from_span":null}]},"bound_body_regions":52,"lo