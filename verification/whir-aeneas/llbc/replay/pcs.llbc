s_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":0}],"output":{"Deduplicated":46}},"src":"Normal","body":"Opaque"},{"def_id":27,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":6},"kind":"InherentImplBlock"}}},{"Ident":["with_capacity",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":524,"col":4},"end":{"line":524,"col":55}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Constructs a new, empty `Vec<T>` with at least the specified capacity."},{"DocComment":""},{"DocComment":" The vector will be able to hold at least `capacity` elements without"},{"DocComment":" reallocating. This method is allowed to allocate for more elements than"},{"DocComment":" `capacity`. If `capacity` is zero, the vector will not allocate."},{"DocComment":""},{"DocComment":" It is important to note that although the returned vector has the"},{"DocComment":" minimum *capacity* specified, the vector will have a zero *length*. For"},{"DocComment":" an explanation of the difference between length and capacity, see"},{"DocComment":" *[Capacity and reallocation]*."},{"DocComment":""},{"DocComment":" If it is important to know the exact allocated capacity of a `Vec`,"},{"DocComment":" always use the [`capacity`] method after construction."},{"DocComment":""},{"DocComment":" For `Vec<T>` where `T` is a zero-sized type, there will be no allocation"},{"DocComment":" and the capacity will always be `usize::MAX`."},{"DocComment":""},{"DocComment":" [Capacity and reallocation]: #capacity-and-reallocation"},{"DocComment":" [`capacity`]: Vec::capacity"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the new capacity exceeds `isize::MAX` _bytes_."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec = Vec::with_capacity(10);"},{"DocComment":""},{"DocComment":" // The vector contains no items, even though it has capacity for more"},{"DocComment":" assert_eq!(vec.len(), 0);"},{"DocComment":" assert!(vec.capacity() >= 10);"},{"DocComment":""},{"DocComment":" // These are all done without reallocating..."},{"DocComment":" for i in 0..10 {"},{"DocComment":"     vec.push(i);"},{"DocComment":" }"},{"DocComment":" assert_eq!(vec.len(), 10);"},{"DocComment":" assert!(vec.capacity() >= 10);"},{"DocComment":""},{"DocComment":" // ...but this may make the vector reallocate"},{"DocComment":" vec.push(11);"},{"DocComment":" assert_eq!(vec.len(), 11);"},{"DocComment":" assert!(vec.capacity() >= 11);"},{"DocComment":""},{"DocComment":" // A vector of a zero-sized type will always over-allocate, since no"},{"DocComment":" // allocation is necessary"},{"DocComment":" let vec_units = Vec::<()>::with_capacity(10);"},{"DocComment":" assert_eq!(vec_units.capacity(), usize::MAX);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"vec_with_capacity","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":0}],"output":{"Deduplicated":25}},"src":"Normal","body":"Opaque"},{"def_id":28,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"A","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":6},"kind":"InherentImplBlock"}}},{"Ident":["len",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":3135,"col":4},"end":{"line":3135,"col":36}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the number of elements in the vector, also referred to"},{"DocComment":" as its 'length'."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = vec![1, 2, 3];"},{"DocComment":" assert_eq!(a.len(), 3);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"A","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":26},{"Var":{"Free":0}}]},{"regions":[],"skip_binder":[{"Deduplicated":28},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[272,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":25},"Shared"]}]}],"output":{"Deduplicated":0}},"src":"Normal","body":"Opaque"},{"def_id":29,"item_meta":{"name":[{"Ident":["pcs",0]},{"Ident":["whir",0]},{"Ident":["strata",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":91,"col":0},"end":{"line":101,"col":1}},"generated_from_span":null}},"source_text":"pub fn strata(count: usize, depth: usize) -> Vec<Stratum> {\n    let mut out = Vec::with_capacity(count);\n    let mut g = usize::BITS as usize;\n    while g > 0 {\n        g -= 1;\n        if count >> g & 1 == 1 {\n            push_group(&mut out, g, g.min(depth));\n        }\n    }\n    out\n}","attr_info":{"attributes":[{"DocComment":" The strata of a batch of `count` queries into `2^depth` positions, in query order."},{"DocComment":""},{"DocComment":" # Overview"},{"DocComment":""},{"DocComment":" The batch is cut by the binary digits of `count`, highest first."},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":"     a group of 2^g queries, s = min(g, depth):"},{"DocComment":"         query j fixes the top s bits of its position to j mod 2^s"},{"DocComment":"         so each of the 2^s cosets of those bits holds equally many of the group's queries"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Why it is sound"},{"DocComment":""},{"DocComment":" - A set every query misses with probability at most `1 - delta` is missed by the batch with probability at most `(1 - delta)^count`."},{"DocComment":" - That is the bound of independent queries (the PCS annex, `thm:rbr`)."},{"DocComment":" - The top `s` levels of a group's Merkle paths are then one complete subtree, hashed once by the verifier."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":0},{"Deduplicated":0}],"output":{"Deduplicated":94}},"src":"Normal","body":{"Structured":{"span":{"Value":[687,{"data":{"file_id":5,"beg":{"line":91,"col":0},"end":{"line":101,"col":1}},"generated_from_span":null}]},"bound_body_regions":7,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[688,{"data":{"file_id":5,"beg":{"line":91,"col":45},"end":{"line":91,"col":57}},"generated_from_span":null}]},"ty":{"Deduplicated":94},"drop_flag_for":null},{"index":1,"name":"count","span":{"Value":[689,{"data":{"file_id":5,"beg":{"line":91,"col":14},"end":{"line":91,"col":19}},"generated_from_span":null}]},"ty":{"Deduplic