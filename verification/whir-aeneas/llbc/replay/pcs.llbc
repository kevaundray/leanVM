\n    fn e_of_limbs(&mut self, limbs: [F64; 3]) -> F192 {\n        F192::new(limbs[0].0, limbs[1].0, limbs[2].0)\n    }\n\n    fn query_point(&mut self, query: &usize) -> F192 {\n        F192::new(*query as u64, 0, 0)\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":494},{"Deduplicated":42},{"Deduplicated":20},{"Deduplicated":0},{"Deduplicated":26}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[{"index":0,"name":null,"variance":"Unknown","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[{"Value":[175,{"kind":{"TraitImpl":{"id":26,"generics":{"regions":["Erased"],"types":[{"Deduplicated":25}],"const_generics":[],"trait_refs":[{"Deduplicated":2}]}}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":494},{"Deduplicated":26}],"const_generics":[],"trait_refs":[]}}}}]},{"Value":[176,{"kind":{"TraitImpl":{"id":27,"generics":{"regions":[],"types":[{"Deduplicated":43}],"const_generics":[{"Deduplicated":8}],"trait_refs":[{"Deduplicated":35}]}}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":42}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":59}],"consts":[],"types":[null,null,null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":56,"generics":{"regions":[{"Var":{"Free":0}},{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"trait_refs":[]}},