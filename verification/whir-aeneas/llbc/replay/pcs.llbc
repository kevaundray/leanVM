  &self,\n        root: &Hash,\n        num_leaves: usize,\n        queries: &[usize],\n        row_words: usize,\n        leaf_words: usize,\n    ) -> Option<Openings> {\n        if !num_leaves.is_power_of_two() || num_leaves == 0 || queries.is_empty() || row_words > leaf_words {\n            return None;\n        }\n        let height = num_leaves.trailing_zeros() as usize;\n        let sorted = sorted_unique(queries);\n        if sorted[sorted.len() - 1] >= num_leaves || self.rows.len() != sorted.len() * row_words {\n            return None;\n        }\n\n        // The rows, one after another, hashed as the committer hashed them: zero prefix shared, leaves batched.\n        let leaf_hashes = hash_rows(&self.rows, sorted.len(), row_words, leaf_words);\n        let mut leaves: Vec<Node> = Vec::with_capacity(sorted.len());\n        let mut i = 0;\n        while i < sorted.len() {\n            leaves.push((sorted[i], leaf_hashes[i]));\n            i += 1;\n        }\n        let (known, starts) = rebuild(leaves, &self.sibling_hashes, height, root)?;\n        expand(&self.rows, &sorted, &known, &starts, queries, row_words, leaf_words)\n    }","attr_info":{"attributes":[{"DocComment":" Verifier side: authenticate this phase against `root` and expand it into"},{"DocComment":" one opening per query, in `queries` order (duplicates included)."},{"DocComment":""},{"DocComment":" The single way to consume a phase, so rows can never be read without the"},{"DocComment":" Merkle check having run. Rebuilding every node on the queried paths both"},{"DocComment":" recomputes the root AND yields each query's full sibling path, so the"},{"DocComment":" pruned form is checked and the unpruned form produced in one walk."},{"DocComment":""},{"DocComment":" `None` on any mismatch: a wrong row count or width, an out-of-range"},{"DocComment":" query, an octopus with too few or too many siblings, or a root that does"},{"DocComment":" not match."}],"inline":null,"rename":null,"public":true