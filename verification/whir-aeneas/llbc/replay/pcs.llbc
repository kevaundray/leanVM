, and"},{"DocComment":" - `slice.len()` equals `chunks.len() * N + remainder.len()`."},{"DocComment":""},{"DocComment":" You can flatten the chunks back into a slice-of-`T` with [`as_flattened`]."},{"DocComment":""},{"DocComment":" [`as_flattened`]: slice::as_flattened"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `N` is zero."},{"DocComment":""},{"DocComment":" Note that this check is against a const generic parameter, not a runtime"},{"DocComment":" value, and thus a particular monomorphization will either always panic"},{"DocComment":" or it will never panic."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['l', 'o', 'r', 'e', 'm'];"},{"DocComment":" let (chunks, remainder) = slice.as_chunks();"},{"DocComment":" assert_eq!(chunks, &[['l', 'o'], ['r', 'e']]);"},{"DocComment":" assert_eq!(remainder, &['m']);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you expect the slice to be an exact multiple, you can combine"},{"DocComment":" `let`-`else` with an empty slice pattern:"},{"DocComment":" ```"},{"DocComment":" let slice = ['R', 'u', 's', 't'];"},{"DocComment":" let (chunks, []) = slice.as_chunks::<2>() else {"},{"DocComment":"     panic!(\"slice didn't have even length\")"},{"DocComment":" };"},{"DocComment":" assert_eq!(chunks, &[['R', 'u'], ['s', 't']]);"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":3,"beg":{"line":1397,"col":4},"end":{"line":1397,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":39},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":100}],"output":{"Value":[1209,{"Adt":{"id":0,"generics":{"regions":[],"types":[{"Value":[1210,{"Ref":[{"Var":{"Free":0}},{"Value":[1211,{"Slice":[{"Deduplicated":99},null]}]},"Shared"]}]},{"Deduplicated":100}],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}]}},"src":"Normal","body":"Opaque"},{"def_id":416,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["from_fn",0]}],"span":{"Untagged":{"data":{"file_id":2,"beg":{"line":109,"col":0},"end":{"line":111,"col":52}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an array where each element is produced by calling `f` with"},{"DocComment":" that element's index while walking forward through the array."},{"DocComment":""},{"DocComment":" This is essentially the same as writing"},{"DocComment":" ```text"},{"DocComment":" [f(0), f(1), f(2), …, f(N - 2), f(N - 1)]"},{"DocComment":" ```"},{"DocComment":" and is similar to `(0..i).map(f)`, just for arrays not iterators."},{"DocComment":""},{"DocComment":" If `N == 0`, this produces an empty array without ever calling `f`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" // type inference is helping us here, the way `from_fn` knows how many"},{"DocComment":" // elements to produce is the length of array down there: only arrays of"},{"DocComment":" // equal lengths can be compared, so the const generic parameter `N` is"},{"DocComment":" // inferred to be 5, thus creating array of 5 elements."},{"DocComment":""},{"DocComment":" let array = core::array::from_fn(|i| i);"},{"DocComment":" // indexes are:    0  1  2  3  4"},{"DocComment":" assert_eq!(array, [0, 1, 2, 3, 4]);"},{"DocComment":""},{"DocComment":" let array2: [usize; 8] = core::array::from_fn(|i| i * 2);"},{"DocComment":" // indexes are:     0  1  2  3  4  5   6   7"},{"DocComment":" assert_eq!(array2, [0, 2, 4, 6, 8, 10, 12, 14]);"},{"DocComment":""},{"DocComment":" let bool_arr = core::array::from_fn::<_, 5, _>(|i| i % 2 == 0);"},{"DocComment":" // indexes are:       0     1      2     3      4"},{"DocComment":" assert_eq!(bool_arr, [true, false, true, false, true]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also capture things, for example to create an array full of clones"},{"DocComment":" where you can't just use `[item; N]` because it's not `Copy`:"},{"DocComment":" ```"},{"DocComment":" let my_string: [String; 2] = std::array::from_fn(|i| format!(\"Hello {i}\"));"},{"DocComment":" assert_eq!(my_string, [\"Hello 0\", \"Hello 1\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The array is generated in ascending index order, starting from the front"},{"DocComment":" and going towards the back, so you can use closures with mutable state:"},{"DocComment":" ```"},{"DocComment":" let mut state = 1;"},{"DocComment":" let a = std::array::from_fn(|_| { let x = state; state *= 2; x });"},{"DocComment":" assert_eq!(a, [1, 2, 4, 8, 16, 32]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"F","variance":"Contravariant"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[{"clause_id":0,"span":{"Value":[4682,{"data":{"file_id":2,"beg":{"line":109,"col":24},"end":{"line":109,"col":40}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":39}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value"