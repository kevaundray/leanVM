s":[]},"skip_binder":{"Deduplicated":8},"kind":"InherentImplBlock"}}},{"Ident":["rotate_left",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":3905,"col":4},"end":{"line":3905,"col":51}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Rotates the slice in-place such that the first `mid` elements of the"},{"DocComment":" slice move to the end while the last `self.len() - mid` elements move to"},{"DocComment":" the front."},{"DocComment":""},{"DocComment":" After calling `rotate_left`, the element previously at index `mid` will"},{"DocComment":" become the first element in the slice."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function will panic if `mid` is greater than the length of the"},{"DocComment":" slice. Note that `mid == self.len()` does _not_ panic and is a no-op"},{"DocComment":" rotation."},{"DocComment":""},{"DocComment":" # Complexity"},{"DocComment":""},{"DocComment":" Takes linear (in `self.len()`) time."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut a = ['a', 'b', 'c', 'd', 'e', 'f'];"},{"DocComment":" a.rotate_left(2);"},{"DocComment":" assert_eq!(a, ['c', 'd', 'e', 'f', 'a', 'b']);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Rotating a subslice:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut a = ['a', 'b', 'c', 'd', 'e', 'f'];"},{"DocComment":" a[1..5].rotate_left(1);"},{"DocComment":" assert_eq!(a, ['a', 'c', 'd', 'e', 'b', 'f']);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"reg