 &mut V, point: &[E]) -> E {\n        assert_eq!(point.len(), self.log_msg_cols, \"a point of the level's cube\");\n        let normalizers = Normalizers::new(self.log_msg_cols);\n        // Each factor is affine in `s`: `1 + p (1 + s / sigma) = (1 + p) + (p / sigma) s`.\n        let lin = affine_factors(v, point, normalizers.inverses());\n        let zero = v.zero();\n        let mut acc = zero;\n        for i in 0..self.queries.len().min(self.weights.len()) {\n            let s = v.query_point(&self.queries[i]);\n            let product = basis_product(v, &lin, normalizers.at_roots(), s);\n            acc = v.mul_add(self.weights[i], product, acc);\n        }\n        acc\n    }","attr_info":{"attributes":[{"DocComment":" The multilinear extension of the level's induced basis at `point`, in closed form."},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":"     sum_i w_i prod_k (1 + p_k (1 + s_k(q_i) / s_k(v_k)))"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here `q_i` is query `i`'s position read as an element of `K`, and `s_k` the `k`-th subspace polynomial."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"Q","variance":"Unknown"},{"index":1,"name":"E","variance":"Unknown"},{"index":2,"name":"V","variance":"Invariant"},{"index":3,"name":"Clause1_Root","variance":"Invariant"},{"index":4,"name":"Clause1_K","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":10},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":45}],"const_generics":[]