ses.push(at_roots[k].inv());\n            k += 1;\n        }\n        Self { at_roots, inverses }\n    }","attr_info":{"attributes":[{"DocComment":" The normalizers of a domain of `2^log_n` points."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":0}],"output":{"Deduplicated":22}},"src":"Normal","body":{"Structured":{"span":{"Value":[2223,{"data":{"file_id":82,"beg":{"line":46,"col":4},"end":{"line":75,"col":5}},"generated_from_span":null}]},"bound_body_regions":63,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"Value":[2224,{"data":{"file_id":82,"beg":{"line":46,"col":39},"end":{"line":46,"col":43}},"generated_from_span":null}]},"ty":{"Deduplicated":22},"drop_flag_for":null},{"index":1,"name":"log_n","span":{"Value":[2225,{"data":{"file_id":82,"beg":{"line":46,"col":22},"end":{"line":46,"col":27}},"generated_from_span":null}]},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":2,"name":"at_roots","span":{"Value":[2226,{"data":{"file_id":82,"beg":{"line":50,"col":12},"end":{"line":50,"col":24}},"generated_from_span":null}]},"ty":{"Deduplicated":64},"drop_flag_for":null},{"index":3,"name":null,"span":{"Value":[2227,{"data":{"file_id":82,"beg":{"line":50,"col":42},"end":{"line":50,"col":51}},"generated_from_span":null}]},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":4,"name":null,"span":{"Value":[2228,{"data":{"file_id":82,"beg":{"line":50,"col":42},"end":{"line":50,"col":47}},"generated_from_span":null}]},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":5,"name":"row","span":{"Value":[2229,{"data":{"file_id":82,"beg":{"line":51,"col":12},"end":{"line":51,"col":19}},"g