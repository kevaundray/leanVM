\n        level += 1;\n    }\n    starts.push(known.len());\n    // The last fold leaves exactly the root, and nothing may be left over.\n    if used < siblings.len() || nodes.is_empty() || nodes[0].1 != *root {\n        return None;\n    }\n    Some((known, starts))\n}","attr_info":{"attributes":[{"DocComment":" Rebuild every node on the queried paths bottom-up from the `leaves` (ascending by index),"},{"DocComment":" pulling a stored sibling only where that sibling is not itself a queried subtree."},{"DocComment":""},{"DocComment":" Returns every level's known nodes in one buffer, level `l` at `starts[l]..starts[l + 1]`"},{"DocComment":" (both children of each parent, ascending by index), and `starts`. Returns nothing when the"},{"DocComment":" siblings run out or are left over, or the last fold is not `root`."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":52},{"Value":[125,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":68},"Shared"]}]},{"Deduplicated":0},{"Deduplicated":28}],"output":{"Deduplicated":66}},"src":"Normal","body":{"Structured":{"span":{"Value":[283,{"data":{"file_id":5,"beg":{"line":520,"col":0},"end":{"line":539,"col":1}},"generated_from_span":null}]},"bound_body_regions":131,"locals":{"arg_count":4,"locals":[{"index":0,"name":null,"span":{"Value":[284,{"data":{"file_id":5,"beg":{"line":520,"col":83},"end":{"line":520,"col":114}},"generated_from_span":null}]},"ty":{"Deduplicated":66},"drop_flag_for":null},{"index":1,"name":"nodes","span":{"Value":[285