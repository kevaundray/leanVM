ef_id":28,"item_meta":{"name":[{"Ident":["pcs",0]},{"Ident":["merkle",0]},{"Ident":["hash_rows",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":463,"col":0},"end":{"line":468,"col":1}},"generated_from_span":null}},"source_text":"fn hash_rows(rows: &[F64], n: usize, row_words: usize, leaf_words: usize) -> Vec<Hash> {\n    let mut leaf_hashes = Box::new_uninit_slice(n);\n    LeafHasher::new(8 * row_words, 8 * leaf_words).hash(words_as_bytes(rows), &mut leaf_hashes);\n    // SAFETY: the hasher wrote one digest per row.\n    unsafe { leaf_hashes.assume_init() }.into_vec()\n}","attr_info":{"attributes":[{"DocComment":" Each of the `n` rows' leaf digest, in order: rows of `row_words` words one after another,"},{"DocComment":" each hashed as its leaf image of `leaf_words` words, the missing words a zero prefix."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics unless `0 < row_words <= leaf_words`, as [`LeafHasher::new`] does."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[124,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":47},"Shared"]}]},{"Deduplicated":0},{"Deduplicated":0},{"Deduplicated":0}],"output":{"Deduplicated":10}},"src":"Normal","body":"Opaque"},{"def_id":29,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":5},"kind":"InherentImplBlock"}}},{"Ident":["with_capacity",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":524,"col":4},"end":{"line":524,"col":55}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Constructs a new, empty `Vec<T>` with at least the specified capacity."},{"DocComment":""},{"DocComment":" The vector will be able to hold at least `capacity` elements without"},{"DocComment":" reallocating. This method is allowed to allocate for more elements than"},{"DocComment":" `capacity`. If `capacity` is zero, the vector will not allocate."},{"DocComment":""},{"DocComment":" It is important to note that although the returned vector has the"},{"DocComment":" minimum *capacity* specified, the vector will have a zero *length*. For"},{"DocComment":" an explanation of the difference between length and capacity, see"},{"DocComment":" *[Capacity and reallocation]*."},{"DocComment":""},{"DocComment":" If it is important to know the exact allocated capacity of a `Vec`,"},{"DocComment":" always use the [`capacity`] method after construction."},{"DocComment":""},{"DocComment":" For `Vec<T>` where `T` is a zero-sized type, there will be no allocation"},{"DocComment":" and the capacity will always be `usize::MAX`."},{"DocComment":""},{"DocComment":" [Capacity and reallocation]: #capacity-and-reallocation"},{"DocComment":" [`capacity`]: Vec::capacity"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the new capacity exceeds `isize::MAX` _bytes_."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec = Vec::with_capacity(10);"},{"DocComment":""},{"DocComment":" // The vector contains no items, even though it has capacity for more"},{"DocComment":" assert_eq!(vec.len(), 0);"},{"DocComment":" assert!(vec.capacity() >= 10);"},{"DocComment":""},{"DocComment":" // These are all done without reallocating..."},{"DocComment":" for i in 0..10 {"},{"DocComment":"     vec.push(i);"},{"