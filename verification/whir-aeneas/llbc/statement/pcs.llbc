"col":57}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for indexing operations (`container[index]`) in mutable contexts."},{"DocComment":""},{"DocComment":" `container[index]` is actually syntactic sugar for"},{"DocComment":" `*container.index_mut(index)`, but only when used as a mutable value. If"},{"DocComment":" an immutable value is requested, the [`Index`] trait is used instead. This"},{"DocComment":" allows nice things such as `v[index] = value`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" A very simple implementation of a `Balance` struct that has two sides, where"},{"DocComment":" each can be indexed mutably and immutably."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::{Index, IndexMut};"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" enum Side {"},{"DocComment":"     Left,"},{"DocComment":"     Right,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" enum Weight {"},{"DocComment":"     Kilogram(f32),"},{"DocComment":"     Pound(f32),"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct Balance {"},{"DocComment":"     pub left: Weight,"},{"DocComment":"     pub right: Weight,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Index<Side> for Balance {"},{"DocComment":"     type Output = Weight;"},{"DocComment":""},{"DocComment":"     fn index(&self, index: Side) -> &Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance immutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &self.left,"},{"DocComment":"             Side::Right => &self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl IndexMut<Side> for Balance {"},{"DocComment":"     fn index_mut(&mut self, index: Side) -> &mut Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance mutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &mut self.left,"},{"DocComment":"             Side::Right => &mut self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut balance = Balance {"},{"DocComment":"     right: Weight::Kilogram(2.5),"},{"DocComment":"     left: Weight::Pound(1.5),"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" // In this case, `balance[Side::Right]` is sugar for"},{"DocComment":" // `*balance.index(Side::Right)`, since we are only *reading*"},{"DocComment":" // `balance[Side::Right]`, not writing it."},{"DocComment":" assert_eq!(balance[Side::Right], Weight::Kilogram(2.5));"},{"DocComment":""},{"DocComment":" // However, in this case `balance[Side::Left]` is sugar for"},{"DocComment":" // `*balance.index_mut(Side::Left)`, since we are writing"},{"DocComment":" // `balance[Side::Left]`."},{"DocComment":" balance[Side::Left] = Weight::Kilogram(3.0);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"IndexMut","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Idx","variance":"Unknown"},{"index":2,"name":"Self_Clause0_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[275,{"data":{"file_id":9,"beg":{"line":170,"col":39},"end":{"line":170,"col":57}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":12},{"Deduplicated":22},{"Deduplicated":36}],"const_generics":[],"trait_refs":[]}}}}],"consts":