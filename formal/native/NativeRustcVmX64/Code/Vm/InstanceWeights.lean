  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.call Width.W64 (RelRegOrMem.mem (AddrExpr.mk (@Option.some RegOrRip RegOrRip.rip) (@Option.none AddrIndex) (ConstExpr.sub (ConstExpr.gotSlot "memcpy") ConstExpr.after_current_instruction)))))  -- callq *memcpy@GOTPCREL(%rip)
]

/-- Block 4, after the branch or call ending block 3. -/
def b4 : List Directive := [
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.add Width.W64 (@RegOrMem.reg Width.W64 (Reg.low Reg64.rsp Width.W64)) (@Operand.imm Width.W64 (ConstExpr.int64 (984 : Int64))))),  -- addq $984, %rsp
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.pop Width.W64 (@RegOrMem.reg Width.W64 (Reg.low Reg64.rbx Width.W64)))),  -- popq %rbx
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.pop Width.W64 (@RegOrMem.reg Width.W64 (Reg.low Reg64.r12 Width.W64)))),  -- popq %r12
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.pop Width.W64 (@RegOrMem.reg Width.W64 (Reg.low Reg64.r13 Width.W64)))),  -- popq %r13
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.pop Width.W64 (@RegOrMem.reg Width.W64 (Reg.low Reg64.r14 Width.W64)))),  -- popq %r14
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.pop Width.W64 (@RegOrMem.reg Width.W64 (Reg.low Reg64.r15 Width.W64)))),  -- popq %r15
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.pop Width.W64 (@RegOrMem.reg Width.W64 (Reg.low Reg64.rbp Width.W64)))),  -- popq %rbp
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.ret Width.W64))  -- retq
]

/-- The function's code: its blocks in order. -/
def code : List Directive := List.flatten [b0, b1, b2, b3, b4]

def codeLength : Nat := 417

def b0Offset : Nat := 0

def b0Length : Nat := 63

def b0End : Nat := 63

def b1Offset : Nat := 63

def b1Length : Nat := 145

def b1End : Nat := 208

def b2Offset : Nat := 208

def b2Length : Nat := 181

def b2End : Nat := 389

def b3Offset : Nat := 389

def b3Length : Nat := 20

def b3End : Nat := 409

def b4Offset : Nat := 409

def b4Length : Nat := 8

def b4End : Nat := 417

def entryOffset : Nat := 0

def label_1Offset : Nat := 208

end

-- One lemma at a time: many kernel checks at once exceed a 60 GB address-space limit.
set_option Elab.async false

public theorem code_length : code.length = codeLength := by decide +kernel

public theorem b0_in_code : b0.IsInfixAt code b0Offset :=
  List.isInfixAt_flatten_of (i := 0) rfl (by decide +kernel)

public theorem b0_length : b0.length = b0Length := by decide +kernel

public theorem b0_end : b0Offset + b0.length = b0End := by decide +kernel

public theorem b0_next : b0Offset + b0.length = b1Offset := by decide +kernel

public theorem b1_in_code : b1.IsInfixAt code b1Offset :=
  List.isInfixAt_flatten_of (i := 1) rfl (by decide +kernel)

public theorem b1_length : b1.length = b1Length := by decide +kernel

public theorem b1_end : b1Offset + b1.length = b1End := by decide +kernel

public theorem b1_next : b1Offset + b1.length = b2Offset := by decide +kernel

public theorem b2_in_code : b2.IsInfixAt code b2Offset :=
  List.isInfixAt_flatten_of (i := 2) rfl (by decide +kernel)

public theorem b2_length : b2.length = b2Length := by decide +kernel

public theorem b2_end : b2Offset + b2.length = b2End := by decide +kernel

public theorem b2_next : b2Offset + b2.length = b3Offset := by decide +kernel

public theorem b3_in_code : b3.IsInfixAt code b3Offset :=
  List.isInfixAt_flatten_of (i := 3) rfl (by decide +kernel)

public theorem b3_length : b3.length = b3Length := by decide +kernel

public theorem b3_end : b3Offset + b3.length = b3End := by decide +kernel

public theorem b3_next : b3Offset + b3.length = b4Offset := by decide +kernel

public theorem b4_in_code : b4.IsInfixAt code b4Offset :=
  List.isInfixAt_flatten_of (i := 4) rfl (by decide +kernel)

public theorem b4_length : b4.length = b4Length := by decide +kernel

public theorem b4_end : b4Offset + b4.length = b4End := by decide +kernel

public theorem entry_at : code[entryOffset]? = some (.label entryLabel) := by decide +kernel

public theorem label_1_at : code[label_1Offset]? = some (.label label_1) := by decide +kernel

end NativeRustcVmX64.Vm.InstanceWeights
