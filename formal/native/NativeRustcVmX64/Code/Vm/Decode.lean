  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.pop Width.W64 (@RegOrMem.reg Width.W64 (Reg.low Reg64.r14 Width.W64)))),  -- popq %r14
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.pop Width.W64 (@RegOrMem.reg Width.W64 (Reg.low Reg64.r15 Width.W64)))),  -- popq %r15
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.pop Width.W64 (@RegOrMem.reg Width.W64 (Reg.low Reg64.rbp Width.W64)))),  -- popq %rbp
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.ret Width.W64))  -- retq
]

/-- Block 16, at `.LDecode_7`. -/
def b16 : List Directive := [
  @Kraken.Directive.label Instr ConstExpr ".LDecode_7",  -- .LDecode_7:
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.cmp Width.W64 (@RegOrMem.mem Width.W64 (AddrExpr.mk (@Option.some RegOrRip (RegOrRip.reg Reg64.rsp)) (@Option.none AddrIndex) (ConstExpr.int64 (16 : Int64)))) (@Operand.regOrMem Width.W64 (@RegOrMem.reg Width.W64 (Reg.low Reg64.r15 Width.W64))))),  -- cmpq %r15, 16(%rsp)
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W8 (@Operation.setcc Width.W8 CondCode.z (@RegOrMem.reg Width.W8 (Reg.low Reg64.rax Width.W8)))),  -- sete %al
  @Kraken.Directive.instr Instr ConstExpr (Instr.regular Width.W64 Width.W64 (@Operation.jmp Width.W64 (RelRegOrMem.rel (ConstExpr.sub (ConstExpr.label ".LDecode_10") ConstExpr.after_current_instruction))))  -- jmp .LDecode_10
]

/-- The function's code: its blocks in order. -/
def code : List Directive := List.flatten [b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16]

