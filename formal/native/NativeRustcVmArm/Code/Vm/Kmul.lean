  @Kraken.Directive.instr Instr ConstExpr (Instr.mk RegWidth.W64 (@Operation.EOR_s RegWidth.W64 (RegOrZr.low (XRegOrXzr.reg XReg.X9) RegWidth.W64) (RegOrZr.low (XRegOrXzr.reg XReg.X9) RegWidth.W64) (@ShiftRegExpr.mk RegWidth.W64 (RegOrZr.low (XRegOrXzr.reg XReg.X8) RegWidth.W64) (4 : Int64) ShiftType.LSL))),  -- eor x9, x9, x8, lsl #4
  @Kraken.Directive.instr Instr ConstExpr (Instr.mk RegWidth.W64 (@Operation.EOR_s RegWidth.W64 (RegOrZr.low (XRegOrXzr.reg XReg.X0) RegWidth.W64) (RegOrZr.low (XRegOrXzr.reg XReg.X9) RegWidth.W64) (@ShiftRegExpr.mk RegWidth.W64 (RegOrZr.low (XRegOrXzr.reg XReg.X8) RegWidth.W64) (0 : Int64) ShiftType.LSL))),  -- eor x0, x9, x8
  @Kraken.Directive.instr Instr ConstExpr (Instr.mk RegWidth.W64 (@Operation.ADD_e RegWidth.W64 (RegOrSp.low XRegOrSp.SP RegWidth.W64) (RegOrSp.low XRegOrSp.SP RegWidth.W64) (ExtOrImmReg.imm (ImmExpr.mk (ConstExpr.int64 (112 : Int64)) ImmShift.S0)))),  -- add sp, sp, #112
  @Kraken.Directive.instr Instr ConstExpr (Instr.mk RegWidth.W64 (Operation.RET (RegOrZr.low (XRegOrXzr.reg XReg.X30) RegWidth.W64)))  -- ret
]

/-- The function's code: its blocks in order. -/
def code : List Directive := List.flatten [b0]

end

-- One lemma at a time: many kernel checks at once exceed a 60 GB address-space limit.
set_option Elab.async false

public theorem b0_in_code : b0.IsInfixAt code 0 :=
  List.isInfixAt_flatten_of (i := 0) rfl (by decide +kernel)

