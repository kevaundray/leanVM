/-- The function's code: its blocks in order. -/
def code : List Directive := List.flatten [b0, b1, b2, b3]

def codeLength : Nat := 218

def b0Offset : Nat := 0

def b0Length : Nat := 15

def b0End : Nat := 15

def b1Offset : Nat := 15

def b1Length : Nat := 18

def b1End : Nat := 33

def b2Offset : Nat := 33

def b2Length : Nat := 158

def b2End : Nat := 191

def b3Offset : Nat := 191

def b3Length : Nat := 27

def b3End : Nat := 218

